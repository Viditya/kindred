# Copy to .env. Any channel WITHOUT a client id runs in DEMO mode (mock signals).
PORT=8787
PUBLIC_URL=http://localhost:8787

# Register OAuth apps, redirect URI = {PUBLIC_URL}/api/oauth/<channel>/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Goodreads has no OAuth API; users enter their public Goodreads user id.

# IBM watsonx.ai — activate the AI concierge (POST /api/concierge)
# Without these, the concierge falls back to rule-based replies.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# File store path (default: ./data/db.json)
DB_FILE=
